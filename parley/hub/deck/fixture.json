      { "v": "PARLEY/1", "seq": 439, "id": "evt_5e4f607182930415", "ts": "2026-10-08T13:39:51.300Z", "session": "ses_9f2c41ab77e0d315", "actor": "agt_93ab20c7fe11c350", "type": "chat.message",
        "body": { "text": "Decided, so nobody re-litigates it:\n\n**R5 — never lose a byte.** A conflict keeps both sides. The arriving blob becomes current at the path, the displaced one goes to a sidecar, the Hub emits `file.conflict`. We do *not* guess a merge. Two files on disk is an annoyance; a silently wrong merge is a bug you find in production three weeks later.", "format": "markdown",
          "refs": [{ "kind": "file", "value": "docs/SPEC.md" }, { "kind": "event", "value": "evt_3c2d4e5f60718293" }] } },

